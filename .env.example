# trios-mcp-rag — local environment template.
# Copy this file to .env and fill in real values LOCALLY.
# Do NOT commit .env. Rule 4 of AGENTS.md forbids committing DSNs / tokens.

# Railway / Postgres DSN for the GOLDEN BRIDGE SSOT.
# Either TRIOS_DATABASE_URL or DATABASE_URL is acceptable — pick one and
# stick with it; do not set both with different values.
TRIOS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Optional canonical-build identifier; reference only by name in commits.
# Example value (illustrative, do not reuse): IGLA-SHORT-WAVE-MATRIX-bf16-h128-LR0.0001-rng1597-sgdm
TRIOS_CANON_NAME=

# Optional Railway API token (only needed for non-MCP automation).
# Never echo, never commit. Revoke immediately if accidentally exposed.
# RAILWAY_TOKEN=

# Optional flag — set to 1 to enforce read-only mode at the server layer
# regardless of caller intent (rule 03 already enforces this by default).
TRIOS_READ_ONLY=1
